# OpenAI — the ONE key, held server-side. Users never see or need a key.
OPENAI_API_KEY=sk-your-key

# Supabase project (create one free at supabase.com, then Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Metering: max proxied OpenAI requests per user per day
DAILY_REQUEST_CAP=200
